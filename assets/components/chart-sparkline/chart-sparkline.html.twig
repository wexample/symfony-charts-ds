{#- A line the size of a word, for a table row: drawn here as svg, so that a
    long table runs no script. The window to highlight is a band behind the
    line, the last value a dot at its end. The extent of the values is said to
    the pointer and to the screen reader alike.

    Fluid (`fluid`), it is as wide as what holds it — the foot of a key
    figure's card —: the svg stretches its box to that width, its stroke kept
    as thin, and the last dot, laid over it in percent, stays round. -#}
{%- set extent = geometry.min is not null ? geometry.min|number_format(0, '', ' ') ~ ' – ' ~ geometry.max|number_format(0, '', ' ') : '' -%}
{%- set said = (label|default(null) ? label ~ ' : ' : '') ~ extent -%}
{%- if fluid|default(false) -%}
    <span class="chart-sparkline chart-sparkline--fluid{% if class|default(null) %} {{ class }}{% endif %}"
          style="--chart-sparkline-height: {{ height }}px"
          role="img"
          aria-label="{{ said }}"
          {%- if said %} title="{{ said }}"{% endif %}>
        <svg viewBox="0 0 {{ width }} {{ height }}" preserveAspectRatio="none" aria-hidden="true">
            {%- if geometry.active -%}
                <rect class="chart-sparkline--active" x="{{ geometry.active.x }}" y="0" width="{{ geometry.active.width }}" height="{{ height }}"></rect>
            {%- endif -%}
            {%- if geometry.points -%}
                <polyline class="chart-sparkline--line" points="{{ geometry.points }}" vector-effect="non-scaling-stroke"></polyline>
            {%- endif -%}
        </svg>
        {%- if geometry.last -%}
            <span class="chart-sparkline--dot" style="left: {{ geometry.last.x / width * 100 }}%; top: {{ geometry.last.y / height * 100 }}%"></span>
        {%- endif -%}
    </span>
{%- else -%}
    <svg class="chart-sparkline{% if class|default(null) %} {{ class }}{% endif %}"
         viewBox="0 0 {{ width }} {{ height }}"
         width="{{ width }}"
         height="{{ height }}"
         role="img"
         aria-label="{{ said }}">
        {%- if said -%}<title>{{ said }}</title>{%- endif -%}
        {%- if geometry.active -%}
            <rect class="chart-sparkline--active" x="{{ geometry.active.x }}" y="0" width="{{ geometry.active.width }}" height="{{ height }}"></rect>
        {%- endif -%}
        {%- if geometry.points -%}
            <polyline class="chart-sparkline--line" points="{{ geometry.points }}"></polyline>
        {%- endif -%}
        {%- if geometry.last -%}
            <circle class="chart-sparkline--last" cx="{{ geometry.last.x }}" cy="{{ geometry.last.y }}" r="2"></circle>
        {%- endif -%}
    </svg>
{%- endif -%}
